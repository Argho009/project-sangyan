# SANGYAN Environment Variables
# Copy this file to .env and fill in your API keys

# PhishTank API key (free registration at https://www.phishtank.com/api_register.php)
PHISHTANK_API_KEY=

# I4C API base (default: https://cybercrime.gov.in/Webform/)
I4C_API_BASE=https://cybercrime.gov.in/Webform/

# Google Cloud Vision API credentials (optional — Tesseract is primary)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Server configuration
HOST=0.0.0.0
PORT=8000
